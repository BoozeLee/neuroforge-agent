# NeuroForge Configuration

# Solana RPC endpoint for mainnet
SYNAPSE_RPC_URL=https://api.mainnet-beta.solana.com

# Path to Solana keypair (JSON format)
# Default: keys/agent.json
SOLANA_KEYPAIR_PATH=keys/agent.json

# USDC token mint on Solana
USDC_MINT=EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v

# SNN loop tick interval in seconds
# Default: 300 (5 minutes)
TICK_INTERVAL_SECS=300

# LIF neuron firing threshold (0.0-1.0)
# Default: 0.75
FIRE_THRESHOLD=0.75

# Membrane potential leak rate per tick (0.0-1.0)
# Default: 0.15
LEAK_RATE=0.15

# Logging level
RUST_LOG=neuroforge=info,warn
